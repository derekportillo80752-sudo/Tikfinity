local function limpiarDisco()

	if discoSonido then
		discoSonido:Stop()
		discoSonido:Destroy()
		discoSonido = nil
	end

	if baileTrack then
		baileTrack:Stop()
		baileTrack:Destroy()
		baileTrack = nil
	end

	for _,dato in ipairs(lucesDisco) do
		if dato.part then
			dato.part:Destroy()
		end
	end

	table.clear(lucesDisco)

end

local function crearLucesDisco(root)

	table.clear(lucesDisco)

	for i = 1,4 do

		local part = Instance.new("Part")
		part.Size = Vector3.new(0.5,0.5,0.5)
		part.Transparency = 1
		part.Anchored = true
		part.CanCollide = false
		part.CanTouch = false
		part.CanQuery = false
		part.Parent = workspace

		local luz = Instance.new("PointLight")
		luz.Brightness = 8
		luz.Range = 18
		luz.Parent = part

		table.insert(lucesDisco,{
			part = part,
			luz = luz
		})

	end

	task.spawn(function()

		local tiempo = 0

		while discoSonido
			and discoSonido.Parent
			and discoSonido.IsPlaying do

			tiempo += 0.08

			for i,dato in ipairs(lucesDisco) do

				if dato.part and dato.part.Parent then

					local angulo =
						tiempo * 2 + i * math.pi / 2

					dato.part.Position =
						root.Position +
						Vector3.new(
							math.cos(angulo) * 6,
							3 + math.sin(tiempo * 2 + i),
							math.sin(angulo) * 6
						)

					dato.luz.Color =
						Color3.fromHSV(
							(tiempo * 0.25 + i * 0.25) % 1,
							1,
							1
						)

				end

			end

			task.wait(0.08)

		end

	end)

end

disco.Activated:Connect(function()

	if discoSonido and discoSonido.IsPlaying then
		return
	end

	local character = player.Character
	if not character then return end

	local humanoid =
		character:FindFirstChildOfClass("Humanoid")

	local root =
		character:FindFirstChild("HumanoidRootPart")

	if not humanoid or not root then return end

	local indice

	repeat
		indice = math.random(1,#canciones)
	until #canciones == 1 or indice ~= ultimaCancion

	ultimaCancion = indice

	discoSonido = Instance.new("Sound")
	discoSonido.SoundId =
		"rbxassetid://" .. canciones[indice]

	discoSonido.Volume = 1
	discoSonido.Looped = false
	discoSonido.Parent = SoundService

	crearLucesDisco(root)

	-- Baile durante 3 segundos
	if ANIMATION_ID ~= "TU_ANIMATION_ID" then

		local animator =
			humanoid:FindFirstChildOfClass("Animator")

		if not animator then
			animator = Instance.new("Animator")
			animator.Parent = humanoid
		end

		local anim = Instance.new("Animation")
		anim.AnimationId =
			"rbxassetid://" .. ANIMATION_ID

		local correcto,track =
			pcall(function()
				return animator:LoadAnimation(anim)
			end)

		if correcto and track then

			baileTrack = track
			baileTrack.Looped = false
			baileTrack:Play()

			task.delay(3,function()

				if baileTrack then
					baileTrack:Stop()
					baileTrack:Destroy()
					baileTrack = nil
				end

			end)

		end

	end

	discoSonido:Play()

	discoSonido.Ended:Connect(function()
		limpiarDisco()
	end)

end)

